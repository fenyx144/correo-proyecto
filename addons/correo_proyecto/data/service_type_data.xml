        <field name="days_offset">2</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="service_type_cctv_t2" model="crm.service.type.task">
        <field name="service_type_id" ref="service_type_cctv"/>
        <field name="sequence">2</field>
        <field name="name">Instalación de cámaras y grabador</field>
        <field name="days_offset">6</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="service_type_cctv_t3" model="crm.service.type.task">
        <field name="service_type_id" ref="service_type_cctv"/>
        <field name="sequence">3</field>
        <field name="name">Configuración de acceso remoto</field>
        <field name="days_offset">7</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="service_type_cctv_t4" model="crm.service.type.task">
        <field name="service_type_id" ref="service_type_cctv"/>
        <field name="sequence">4</field>
        <field name="name">Capacitación y acta de entrega</field>
        <field name="days_offset">8</field>
        <field name="user_id" ref="base.user_admin"/>
