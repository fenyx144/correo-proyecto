<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_solicitud" model="ir.ui.view">
        <field name="name">crm.lead.form.solicitud</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-puzzle-piece"
                        invisible="not project_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Proyecto</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Solicitud" name="solicitud" invisible="request_origin != 'email'">
                    <group>
                        <group>
                            <field name="request_origin" readonly="1"/>
                            <field name="service_type_id"/>
                            <field name="urgency" widget="badge"
                                   decoration-danger="urgency == 'alta'"
                                   decoration-warning="urgency == 'media'"
                                   decoration-info="urgency == 'baja'"/>
                            <field name="desired_date"/>
                        </group>
                        <group>
                            <field name="project_id" readonly="1" invisible="not project_id"/>
                            <field name="gmail_message_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Resumen">
                        <field name="ai_summary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Productos solicitados" invisible="not requested_items">
                        <field name="requested_items" nolabel="1" colspan="2"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_solicitud" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.solicitud</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="service_type_id" optional="show"/>
                <field name="urgency" optional="show" widget="badge"
                       decoration-danger="urgency == 'alta'"
                       decoration-warning="urgency == 'media'"
                       decoration-info="urgency == 'baja'"/>
                <field name="request_origin" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_solicitud" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.solicitud</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='open_opportunities']" position="after">
                <separator/>
                <filter string="Desde correo" name="desde_correo" domain="[('request_origin', '=', 'email')]"/>
                <filter string="Urgentes" name="urgentes" domain="[('urgency', '=', 'alta')]"/>
                <filter string="Sin stock" name="sin_stock" domain="[('tag_ids.name', '=', 'Sin stock')]"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="service_type_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Tipo de servicio" name="group_service_type" context="{'group_by': 'service_type_id'}"/>
                <filter string="Urgencia" name="group_urgency" context="{'group_by': 'urgency'}"/>
            </xpath>
        </field>
    </record>
</odoo>
