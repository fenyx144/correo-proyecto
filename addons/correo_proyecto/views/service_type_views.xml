<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_service_type_view_list" model="ir.ui.view">
        <field name="name">crm.service.type.list</field>
        <field name="model">crm.service.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="task_count"/>
            </list>
        </field>
    </record>

    <record id="crm_service_type_view_form" model="ir.ui.view">
        <field name="name">crm.service.type.form</field>
        <field name="model">crm.service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Instalación de red"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tareas" name="tareas">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="days_offset"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_service_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de servicio</field>
        <field name="res_model">crm.service.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="crm_service_type_menu"
              name="Tipos de servicio"
              parent="crm.crm_menu_config"
              action="crm_service_type_action"
              sequence="3"/>
</odoo>
